# Sous-domaine pointant vers l'IP du VPS (enregistrement DNS A "pelerinage")
DOMAIN=pelerinage.creationapp.academy

# Identifiants MongoDB (choisir un mot de passe long, ex. `openssl rand -hex 24`)
MONGO_USER=umrah
MONGO_PASSWORD=change-me

# Jeton de la page d'administration https://pelerinage.creationapp.academy/admin
# (au moins 16 caractères, ex. `openssl rand -hex 32`). Vide = administration désactivée.
ADMIN_TOKEN=

# --- Traefik déjà en place sur le VPS (mêmes valeurs que Neon Strike, cf. /opt/apps/proxy) ---
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
